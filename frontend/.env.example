# Copy to .env and fill in. .env is gitignored — never commit real values.

# Google Cloud console → enable "Maps SDK for Android" → create an API key.
# Without this the draw screen shows an on-screen explanation instead of a map.
GOOGLE_MAPS_API_KEY=

# supabase.com → your project → Settings → API.
# Leave both empty to run the app offline-only; it is a supported mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Which stream of over-the-air updates a locally built APK listens to.
# Leave empty for 'production', which is what you want for a captain's phone.
# Set it to 'preview' only when building an APK you want to test changes on
# without touching the one real captains are carrying.
EAS_UPDATE_CHANNEL=
