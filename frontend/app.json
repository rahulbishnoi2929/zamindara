{
  "expo": {
    "name": "Zamindara",
    "slug": "zamindara",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "android": {
      "package": "com.zamindara.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1B5E20"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Zamindara uses your location to measure your field while you walk its boundary.",
          "locationWhenInUsePermission": "Zamindara uses your location to measure your field while you walk its boundary.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sharing"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
